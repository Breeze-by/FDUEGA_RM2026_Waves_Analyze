# 复制为 wave.env 后按现场设备修改。所有路径均相对项目目录解析。
INFO_RX_RADIO_ID=ip:192.168.2.1
JAMMER_RX_RADIO_ID=ip:192.168.3.1

# auto 依次探测 /dev/referee、ttyACM0~2、ttyUSB*，并排除 Pluto。
REFEREE_PORT=auto
REFEREE_BAUDRATE=115200

JAMMER_STATUS_PORT=5006
WAVE_RETURN_PORT=5007
INFO_STATUS_PORT=5008
INFO_RELAY_PORT=5010
INFO_FAILOVER_RELAY_PORT=5012

INFO_CAPTURE_SAMPLE_RATE_HZ=1000000
JAMMER_CAPTURE_SAMPLE_RATE_HZ=2000000
INFO_STREAM_DECODE_WINDOW_SEC=0.25
INFO_STREAM_DECODE_STRIDE_SEC=0.10
INFO_STREAM_RING_BUFFER_SEC=1.0
INFO_STREAM_WORKER_COUNT=2
INFO_FRESH_WINDOW_SEC=3.0
RADIO_CHECK_INTERVAL_SEC=2.0
PREWARM_INFO_BEFORE_MATCH=true
PREWARM_JAMMER_BEFORE_MATCH=true

# 设为 0 可关闭独立链路监控；监控只检查，不会无限重连掉线设备。
START_LINK_MONITOR=1
